<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Exact alarms are deliberately not requested. A daily weigh-in reminder is not an alarm
      clock: the system delivering it a few minutes either side of half past seven is fine, and
      asking for a privileged permission for something that does not need it is how an app ends
      up on a list of apps that ask for too much. The alarms are still allowed to fire in Doze,
      which is the part that actually matters on a phone left on a bedside table.
    -->

    <!--
      Bluetooth scales. The scan runs only while the weigh-in screen is open, so this is never
      held in the background. neverForLocation says what is true: the app reads a weight out of
      an advertisement and has no interest in where the phone is. Older Android had no way to
      say that, which is why it wants a location permission to read a number off a scale.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!--
      Reading a barcode. The frame is looked at for a number and thrown away: nothing is saved,
      nothing is uploaded, and the camera runs only while the scanning screen is open.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Talking to a machine on the same network as the phone, which is what syncing to a Nextcloud
      or a NAS in the house is. Android 17 asks before allowing it. Requested only when the
      server address really is a local one: a hosted server and the folder mode never prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Health Connect. Only the types with a feature behind them are declared. -->
    <!--
      Reading further back than the last thirty days. Without it Health Connect answers with a
      month whatever window is asked for, so somebody arriving with years of scale history would
      inherit almost none of it and nothing would say why. Refusing it costs the older readings
      and nothing else.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!--
      Reading while the app is not open, which is what the hourly exchange is. Without it a
      background read returns nothing at all rather than failing, so a reading your scale wrote
      would sit unnoticed until you next opened the app and nothing would say why. Refusing it
      leaves the exchange working, on the times you open WeightTrack.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" />
    <!-- Height is deliberately not requested. Nothing reads or writes one, and asking for an
         access the app does not use puts it on the consent screen for no reason. -->
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />
    <!--
      Food. Write only: reading other apps' meals back would double every day for anybody who
      logs in two places, and there is no way to tell a duplicate from a second helping.
    -->
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <!--
      Sleep, read only, for the insight card. Its own grant on purpose: plenty of people are
      happy to share step counts and not the hours they were in bed.
    -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".WeightTrackApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeightTrack">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WeightTrack"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect on Android 13 and below asks for the rationale this way. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14 and above route the same request through this alias. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".notifications.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".notifications.WeeklySummaryReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!--
                  The clock moving under a reminder that was booked in wall-clock time. Setting
                  the time by hand, flying somewhere, and a seasonal offset change all do it;
                  the last of these arrives as its own broadcast from Android 16.
                -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_OFFSET_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          Lets the camera app write a capture straight into private storage. Grants are
          per-URI and temporary; nothing else under files/ is reachable through it.
        -->
        <!--
          The default WorkManager start-up is turned off because the sync job is built by Hilt,
          which needs the factory from the application class. Left on, WorkManager would start
          first with a factory that cannot make the job and it would fail on every run.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".widget.WaterWidgetReceiver"
            android:exported="false"
            android:label="@string/water_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/water_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeightWidgetReceiver"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weight_widget_info" />
        </receiver>
    </application>

</manifest>
